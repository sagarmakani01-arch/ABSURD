# ABSURD backend configuration — copy to .env and adjust, or set as real env vars.
# Nothing here is required: with an empty/absent file ABSURD runs against the
# deterministic template strategy with auth and network tiers disabled.

# --- Gateway ---------------------------------------------------------------
# REST + WebSocket bearer token. Empty string disables auth (development only).
ABSURD_API_TOKEN=

# CORS origins for the Vite dev server (comma-separated).
ABSURD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite by default; any SQLAlchemy URL works.
#ABSURD_DATABASE_URL=sqlite:///./absurd.db

# --- Optional LLM transport (OpenAI-compatible chat completions) -----------
# When all three are set, tool generation uses the model first with fallback to
# the template strategy, and revision requests become available. Leaving them
# empty degrades gracefully (revision_available / generation_available: false).
#ABSURD_LLM_BASE_URL=https://api.openai.com/v1
#ABSURD_LLM_API_TOKEN=sk-...
#ABSURD_LLM_MODEL=gpt-4o
#ABSURD_LLM_TIMEOUT_SECONDS=60

# --- Optional embedding service (OpenAI-compatible /embeddings) ------------
# Enables the semantic matching tier. Schema compatibility always stays
# authoritative; the embedding tier never upgrades a PARTIAL verdict.
#ABSURD_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
#ABSURD_EMBEDDINGS_API_TOKEN=sk-...
#ABSURD_EMBEDDINGS_MODEL=text-embedding-3-small
#ABSURD_EMBEDDINGS_TIMEOUT_SECONDS=30
#ABSURD_EMBEDDING_THRESHOLD=0.5